# Supabase project settings -- get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://vwpnekwgfjxnixtovxjk.supabase.co
SUPABASE_ANON_KEY=replace-with-the-anon-or-publishable-key
# SECRET -- server-side only, never expose to the frontend or commit this file
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-service-role-key

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Anthropic API key for AI lease-document extraction -- get one at https://console.anthropic.com
# Leave blank to disable the feature (the /ai/extract-lease endpoint returns 503).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
